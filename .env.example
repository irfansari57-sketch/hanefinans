# Hane Finans API anahtarları
# Bu dosyayı `.env.local` olarak kopyalayıp gerçek anahtarlarını yaz.
# .env.local git'e gitmez (.gitignore'da).

# === 3. taraf veri anahtarları — SUNUCU TARAFI (13 Eki 2026) ===
# Bunlar VITE_ önekli DEĞİL: istemci bundle'ına girmez. Cloudflare Pages →
# Settings → Environment variables → Secret olarak ekle. Lokal geliştirmede
# `wrangler pages dev` için .dev.vars dosyasına yaz. İstemci /api/proxy/<provider> çağırır.
#   TWELVEDATA_KEY   https://twelvedata.com/register
#   GNEWS_API_KEY    https://gnews.io/register (email doğrulaması gerekli)
#   GOLDAPI_KEY      https://www.goldapi.io/dashboard
#   METALSAPI_KEY    https://metals-api.com/

# === Supabase (backend + DB) — Hafta 2 mimarisi (opsiyonel) ===
# Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === TEFAS Worker (Cloudflare) — gerçek TEFAS fon verisi için ===
# Kurulum: cloudflare/tefas-worker/README.md (5 dakika)
# Doldurulunca fon detay sayfaları canlı NAV/getiri/varlık dağılımı gösterir.
VITE_TEFAS_WORKER_URL=

# === TEFAS GitHub Actions feed — daha kolay alternatif (CF yerine) ===
# Kurulum: SETUP_GITHUB_TEFAS.md (10 dk)
# Saatlik güncellenir, jsDelivr CDN üzerinden okunur.
# Örnek: https://cdn.jsdelivr.net/gh/kullanici/hanefinans-data@main/data/funds.json
VITE_TEFAS_GITHUB_URL=

# === Edge Function secrets (yalnızca Supabase'de tanımlanır, frontend görmez) ===
# Bunları .env.local'a EKLEME. Bunun yerine Supabase Dashboard'tan:
#   Project Settings → Edge Functions → Manage Secrets
# içine ekleyeceksin (komut: supabase secrets set TCMB_API_KEY=...).
#
# Aşağıdaki referans yalnızca hangi secret'ları kuracağını hatırlamak için:
#   TCMB_API_KEY          (evds2.tcmb.gov.tr → Profilim → API Anahtarı)
#   REDDIT_CLIENT_ID
#   REDDIT_CLIENT_SECRET
#   REDDIT_USER_AGENT     (ör. "HaneFinans/0.1 by <reddit-kullanıcı-adı>")
#   VOYAGE_API_KEY        (voyageai.com)
#   TELEGRAM_BOT_TOKEN    (@BotFather)
#   TELEGRAM_CHAT_ID      (botunla konuşup chat_id'yi al — ya da getUpdates ile)

# === Sentry (opsiyonel — hata izleme) ===
# VITE_SENTRY_DSN ayarlanmazsa Sentry SDK yüklenmez, ErrorBoundary sessizce çalışır.
# https://sentry.io → Settings → Projects → [project] → SDK Setup
VITE_SENTRY_DSN=
# Release tag (deploy script'inde inject edebilirsin, opsiyonel)
VITE_APP_VERSION=
